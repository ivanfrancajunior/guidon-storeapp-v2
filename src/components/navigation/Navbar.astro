---
// src/components/navigation/Navbar.astro
const pathname = Astro.url.pathname;
---
<header class="bg-white border-b border-slate-200 sticky top-0 z-30">
  <div class="max-w-[1720px] mx-auto px-4 sm:px-6 py-3.5 flex items-center justify-between">
    <div class="flex items-center gap-6">
      <a href="/" class="flex items-center gap-2.5 group">
        <img
          src="/logo.png"
          alt="Guidon Rodas"
          class="h-11 w-auto rounded-lg object-contain"
        />
        <div class="flex flex-col">
          <span class="font-extrabold text-base tracking-tight text-slate-900 group-hover:text-yellow-600 transition-colors">
            GUIDON RODAS
          </span>
          <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">
            Gestão & Identificação Visual
          </span>
        </div>
      </a>

      <nav class="hidden md:flex items-center gap-1.5 ml-4">
        <a 
          href="/" 
          class={`text-xs font-bold uppercase tracking-wider px-3.5 py-2 rounded-full transition-colors ${
            pathname === '/' ? 'bg-yellow-400 text-slate-950' : 'text-slate-500 hover:text-slate-900'
          }`}
        >
          Catálogo Visual
        </a>
      </nav>
    </div>

    <div class="flex items-center gap-3">
      <a 
        href="/novo" 
        class="inline-flex items-center gap-2 bg-yellow-400 hover:bg-yellow-300 text-slate-950 text-xs font-bold uppercase tracking-wider px-4 py-2.5 rounded-full transition-all shadow-sm hover:shadow active:scale-95"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M12 4v16m8-8H4"></path>
        </svg>
        <span>Novo Produto</span>
      </a>
    </div>
  </div>
</header>
